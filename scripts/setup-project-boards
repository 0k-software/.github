#!/usr/bin/env bash
#
# bin/setup-project-boards
#
# Restructures all non-Roadmap GitHub org project boards to a consistent
# 6-column status layout (Backlog → Refining → Ready → Planning → Coding →
# Done), migrates items from "In Review" / "Reviewing *" columns to "Coding"
# with the "to-review" label applied, and creates the label in the .github
# repo and all source repos that have items in affected projects.
#
# Usage:
#   bin/setup-project-boards [--dry-run] [--apply] [--project <node-id>]
#
# Flags:
#   --dry-run        Print all planned actions without executing (default).
#   --apply          Execute all mutations against the GitHub API.
#   --project <id>   Restrict to a single project by GraphQL node ID; skips
#                    org-wide discovery.
#   -h, --help       Show this help and exit.
#
# Environment:
#   GITHUB_ORG       GitHub organisation to operate on (default: 0k-software).
#

set -euo pipefail

# ── constants ─────────────────────────────────────────────────────────────────

ORG="${GITHUB_ORG:-0k-software}"
REQUIRED_STATUSES=(Backlog Refining Ready Planning Coding Done)
declare -A STATUS_COLORS=(
  [Backlog]=GRAY [Refining]=BLUE [Ready]=GREEN
  [Planning]=YELLOW [Coding]=ORANGE [Done]=PURPLE
)
declare -A STATUS_DESCRIPTIONS=(
  [Backlog]="To be refined"
  [Refining]="Spec in progress"
  [Ready]="Ready to be picked up"
  [Planning]="Building implementation plan"
  [Coding]="Implementation in progress"
  [Done]="Shipped and verified"
)
LABEL_NAME="to-review"
LABEL_COLOR="0075ca"
LABEL_DESC="Waiting for code review"

# ── argument parsing ──────────────────────────────────────────────────────────

MODE="dry-run"
SINGLE_PROJECT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)   MODE=apply ;;
    --dry-run) MODE=dry-run ;;
    --project)
      [[ $# -ge 2 ]] || { echo "error: --project requires a node ID argument" >&2; exit 1; }
      SINGLE_PROJECT="$2"; shift ;;
    -h | --help)
      sed -n '/^# bin\/setup-project-boards/,/^[^#]/{ /^#/{ s/^# \?//; p } }' "$0"
      exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; exit 1 ;;
  esac
  shift
done

# ── helpers ───────────────────────────────────────────────────────────────────

info() { echo "[$MODE] $*"; }

# Run a read-only GraphQL query ($1 = full JSON request body).
gql_query() {
  gh api graphql --input - <<< "$1"
}

# Run a GraphQL mutation. Prints intent in dry-run; sends $2 (JSON) in apply.
gql_mutate() {
  local desc="$1" payload="$2"
  info "MUTATE  $desc"
  [[ "$MODE" == apply ]] || return 0
  gh api graphql --input - <<< "$payload"
}

# Run a REST write. Prints intent in dry-run; runs gh api in apply (ignores errors).
rest_write() {
  local desc="$1"; shift
  info "REST    $desc"
  [[ "$MODE" == apply ]] || return 0
  gh api "$@" 2>/dev/null || info "        (already exists or request failed — continuing)"
}

# ── project discovery ─────────────────────────────────────────────────────────

list_projects() {
  if [[ -n "$SINGLE_PROJECT" ]]; then
    echo "$SINGLE_PROJECT"
    return
  fi

  local cursor="" result has_next
  while true; do
    result=$(gql_query "$(jq -n --arg org "$ORG" --arg cursor "$cursor" '{
      query: "query($org:String!,$cursor:String){ organization(login:$org){ projectsV2(first:50,after:$cursor){ nodes{id title closed} pageInfo{hasNextPage endCursor} } } }",
      variables: { org: $org, cursor: (if $cursor == "" then null else $cursor end) }
    }')")

    jq -r '.data.organization.projectsV2.nodes[]
           | select(.closed == false and (.title | test("Roadmap"; "i") | not)) | .id' <<< "$result"

    has_next=$(jq -r '.data.organization.projectsV2.pageInfo.hasNextPage' <<< "$result")
    [[ "$has_next" == true ]] || break
    cursor=$(jq -r '.data.organization.projectsV2.pageInfo.endCursor' <<< "$result")
  done
}

# ── status field query ────────────────────────────────────────────────────────

get_status_field() {
  local pid="$1"
  gql_query "$(jq -n --arg id "$pid" '{
    query: "query($id:ID!){ node(id:$id){ ... on ProjectV2{ fields(first:30){ nodes{ ... on ProjectV2SingleSelectField{ id name options{id name color description} } } } } } }",
    variables: { id: $id }
  }')" | jq -c 'first(.data.node.fields.nodes[] | select(type == "object" and .name == "Status")) // empty'
}

# ── item iteration ────────────────────────────────────────────────────────────

iter_items() {
  local pid="$1" cursor="" result has_next
  while true; do
    result=$(gql_query "$(jq -n --arg id "$pid" --arg cursor "$cursor" '{
      query: "query($id:ID!,$cursor:String){ node(id:$id){ ... on ProjectV2{ items(first:100,after:$cursor){ nodes{ id fieldValues(first:20){ nodes{ ... on ProjectV2ItemFieldSingleSelectValue{ field{... on ProjectV2SingleSelectField{name}} name optionId } } } content{ ... on Issue{number repository{name owner{login}}} ... on PullRequest{number repository{name owner{login}}} } } pageInfo{hasNextPage endCursor} } } } }",
      variables: { id: $id, cursor: (if $cursor == "" then null else $cursor end) }
    }')")

    jq -c '.data.node.items.nodes[]' <<< "$result"

    has_next=$(jq -r '.data.node.items.pageInfo.hasNextPage' <<< "$result")
    [[ "$has_next" == true ]] || break
    cursor=$(jq -r '.data.node.items.pageInfo.endCursor' <<< "$result")
  done
}

# ── label management ──────────────────────────────────────────────────────────

ensure_label() {
  local repo="$1"
  rest_write "create '$LABEL_NAME' in $repo" \
    "repos/$repo/labels" -X POST \
    -f name="$LABEL_NAME" -f color="$LABEL_COLOR" -f description="$LABEL_DESC"
}

apply_label() {
  local repo="$1" number="$2"
  rest_write "apply '$LABEL_NAME' to $repo#$number" \
    "repos/$repo/issues/$number/labels" -X POST \
    --input - <<< "{\"labels\":[\"$LABEL_NAME\"]}"
}

# ── project mutations ─────────────────────────────────────────────────────────

set_item_status() {
  local pid="$1" item_id="$2" field_id="$3" option_id="$4" desc="$5"
  gql_mutate "$desc" "$(jq -n \
    --arg pid "$pid" --arg iid "$item_id" --arg fid "$field_id" --arg oid "$option_id" '{
      query: "mutation($pid:ID!,$iid:ID!,$fid:ID!,$oid:String!){ updateProjectV2ItemFieldValue(input:{projectId:$pid,itemId:$iid,fieldId:$fid,value:{singleSelectOptionId:$oid}}){ projectV2Item{id} } }",
      variables: { pid: $pid, iid: $iid, fid: $fid, oid: $oid }
    }')"
}


set_field_options() {
  local field_id="$1" opts
  opts=$(for s in "${REQUIRED_STATUSES[@]}"; do
    printf '{"name":"%s","color":"%s","description":"%s"}\n' \
      "$s" "${STATUS_COLORS[$s]:-GRAY}" "${STATUS_DESCRIPTIONS[$s]:-}"
  done | jq -sc '.')
  gql_mutate "set Status options to [${REQUIRED_STATUSES[*]}]" "$(jq -n \
    --arg fid "$field_id" --argjson opts "$opts" '{
      query: "mutation($fid:ID!,$opts:[ProjectV2SingleSelectFieldOptionInput!]!){ updateProjectV2Field(input:{fieldId:$fid,singleSelectOptions:$opts}){ projectV2Field{ ... on ProjectV2SingleSelectField{id options{id name}} } } }",
      variables: { fid: $fid, opts: $opts }
    }')"
}

# ── main ──────────────────────────────────────────────────────────────────────

main() {
  info "=== setup-project-boards | mode=$MODE | org=$ORG ==="

  # 1. Discover projects.
  mapfile -t projects < <(list_projects)
  info "Projects to process: ${#projects[@]}"
  [[ ${#projects[@]} -gt 0 ]] || { info "No projects found."; exit 0; }

  # 2. Collect all source repos across targeted projects (labels must exist before migration).
  #    Always include .github as the org-wide label default.
  declare -A source_repos=()
  local owner="" repo_name=""
  info "Scanning items for source repo list…"
  for pid in "${projects[@]}"; do
    while IFS= read -r item; do
      owner=$(jq -r '.content.repository.owner.login // empty' <<< "$item")
      repo_name=$(jq -r '.content.repository.name // empty' <<< "$item")
      [[ -n "$owner" && -n "$repo_name" ]] && source_repos["$owner/$repo_name"]=1
    done < <(iter_items "$pid")
  done
  source_repos["$ORG/.github"]=1
  info "Source repos: ${!source_repos[*]}"

  # 3. Create the to-review label in .github and all source repos.
  for rp in "${!source_repos[@]}"; do
    ensure_label "$rp"
  done

  # 4. Per-project restructure.
  local -a to_reassign opt_names
  local field_json field_id item status item_id issue_num repo_path
  local entry new_field target_name nid i opt

  for pid in "${projects[@]}"; do
    info "--- project $pid ---"

    field_json=$(get_status_field "$pid" || true)
    if [[ -z "$field_json" ]]; then
      info "  No Status field found — skipping."
      continue
    fi
    field_id=$(jq -r '.id' <<< "$field_json")
    info "  Status field: $field_id"

    # Build: required-status lookup, migration-target map, review-column set.
    declare -A req_set=() migrate_to=() is_review=()
    for s in "${REQUIRED_STATUSES[@]}"; do req_set["$s"]=1; done

    mapfile -t opt_names < <(jq -r '.options[].name' <<< "$field_json")
    for i in "${!opt_names[@]}"; do
      opt="${opt_names[$i]}"
      [[ -n "${req_set[$opt]:-}" ]] && continue  # keep required options as-is

      if [[ "$opt" == "In progress" ]]; then
        # "In progress" is the coding slot — items belong in Coding.
        migrate_to["$opt"]="Coding"
      else
        # Target is the effective status of the immediately preceding option.
        # Required options resolve to themselves; deleted options propagate their
        # own target, so chains like [Planning, In progress, In Review, Ready to deploy]
        # correctly route everything after In progress to Coding rather than Planning.
        if (( i > 0 )); then
          local prev="${opt_names[$((i-1))]}"
          if [[ -n "${req_set[$prev]:-}" ]]; then
            target_name="$prev"
          elif [[ -n "${migrate_to[$prev]:-}" ]]; then
            target_name="${migrate_to[$prev]}"
          else
            target_name="${REQUIRED_STATUSES[0]}"
          fi
        else
          target_name="${REQUIRED_STATUSES[0]}"
        fi
        migrate_to["$opt"]="$target_name"
      fi

      # Case-insensitive match for review-type columns.
      [[ "${opt,,}" =~ ^(in\ review|reviewing\ .+)$ ]] && is_review["$opt"]=1
    done

    # Scan ALL items with any status. updateProjectV2Field recreates every option
    # ID — even options whose names are kept — so every item needs re-assigning.
    to_reassign=()
    while IFS= read -r item; do
      status=$(jq -r '[.fieldValues.nodes[] | select(.field.name == "Status") | .name] | first // empty' <<< "$item")
      [[ -n "$status" ]] || continue

      item_id=$(jq -r '.id' <<< "$item")
      owner=$(jq -r '.content.repository.owner.login // empty' <<< "$item")
      repo_name=$(jq -r '.content.repository.name // empty' <<< "$item")
      issue_num=$(jq -r '.content.number // empty' <<< "$item")
      repo_path="$owner/$repo_name"

      if [[ -n "${migrate_to[$status]:-}" ]]; then
        target_name="${migrate_to[$status]}"
        [[ -n "${is_review[$status]:-}" && -n "$owner" && -n "$issue_num" ]] && \
          apply_label "$repo_path" "$issue_num"
      elif [[ -n "${req_set[$status]:-}" ]]; then
        target_name="$status"
      else
        continue
      fi

      to_reassign+=("$item_id|$status|$repo_path|$issue_num|$target_name")
    done < <(iter_items "$pid")

    # Log what the field update will do, immediately before the mutation.
    local found
    for s in "${REQUIRED_STATUSES[@]}"; do
      found=0
      for o in "${opt_names[@]}"; do [[ "$o" == "$s" ]] && { found=1; break; }; done
      (( found )) || info "  Creating '$s'"
    done
    for opt in "${opt_names[@]}"; do
      [[ -n "${migrate_to[$opt]:-}" ]] || continue
      local tag=""
      [[ -n "${is_review[$opt]:-}" ]] && tag=" (items had to-review label applied)"
      info "  Removing '$opt' (items re-assigned to '${migrate_to[$opt]}'$tag)"
    done

    # Restructure the Status field: replace all options with the required set.
    set_field_options "$field_id"

    # Re-assign all items using post-update option IDs. In dry-run, option IDs
    # are placeholders — gql_mutate logs the intent without executing.
    if [[ ${#to_reassign[@]} -gt 0 ]]; then
      declare -A new_opt_ids=()
      if [[ "$MODE" == apply ]]; then
        new_field=$(get_status_field "$pid")
        while IFS=$'\t' read -r noid noname; do
          new_opt_ids["$noname"]="$noid"
        done < <(jq -r '.options[] | [.id, .name] | @tsv' <<< "$new_field")
      fi

      for entry in "${to_reassign[@]}"; do
        IFS='|' read -r item_id status repo_path issue_num target_name <<< "$entry"
        nid="${new_opt_ids[$target_name]:-}"
        if [[ "$MODE" == apply && -z "$nid" ]]; then
          info "  WARNING: target '$target_name' not found post-update for item $item_id"
          continue
        fi
        set_item_status "$pid" "$item_id" "$field_id" "${nid:-(tbd)}" \
          "$status → $target_name ($repo_path#$issue_num)"
      done
      unset new_opt_ids
    fi

    info "  NOTE: if board columns look stale, open the view → ··· menu → 'Edit view' and re-save."

    unset req_set migrate_to is_review
  done

  info "=== done ==="
}

main "$@"
