#!/usr/bin/env bash
#
# Checks that skill template copies are in sync with the source issue templates.
# Used by both CI and the pre-commit hook.
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"

src="$repo_root/.github/ISSUE_TEMPLATE"
dst="$repo_root/0k/references/templates"

out_of_sync=false

# Check every numbered template in src has an identical copy in dst
for f in "$src"/[0-9]*.yml; do
  [ -f "$f" ] || continue
  name="$(basename "$f")"
  if [ ! -f "$dst/$name" ]; then
    echo "ERROR: Missing from skill templates: $name"
    out_of_sync=true
  elif ! diff -q "$f" "$dst/$name" > /dev/null 2>&1; then
    echo "ERROR: Out of sync: $name"
    diff --unified "$f" "$dst/$name" || true
    out_of_sync=true
  fi
done

# Check dst doesn't have stale files that no longer exist in src
for f in "$dst"/[0-9]*.yml; do
  [ -f "$f" ] || continue
  name="$(basename "$f")"
  if [ ! -f "$src/$name" ]; then
    echo "ERROR: Stale skill template (no longer in ISSUE_TEMPLATE): $name"
    out_of_sync=true
  fi
done

if [ "$out_of_sync" = true ]; then
  echo ""
  echo "Skill templates are out of sync. Run 'make sync-skill-templates' and commit the result."
  exit 1
fi

echo "All skill templates are in sync."
